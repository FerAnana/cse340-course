<%- include('partials/header') %>
<main class="projects-main">
    <h1 class="page-title"><%= title %></h1>

    <ul id="projects-list" class="card-list">
        <% projects.forEach((project) => { %>
            <li class="card-item project-row-item">
                <a class="project-title-link" href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>
                <a class="org-tag-link" href="/organization/<%= project.organization_id %>">
                    (<%= project.name %>)
                </a>
            </li>
        <% }); %>
    </ul>

    <div class="page-action-footer">
        <a class="btn-action-link" href="/new-project">Create a new project</a>
    </div>
</main>
<%- include('partials/footer') %>