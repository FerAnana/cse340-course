<%- include('partials/header') %>
    <main class="category-detail-main">
        <h1 class="page-title">
            <%= title %>
        </h1>

        <section class="category-profile-section">
            <h2 class="category-heading">
                <%= category.category_name %>
            </h2>
        </section>
        <div class="page-action-footer">
            <a class="btn-action-link" href="/edit-category/<%= category.category_id %>">Edit category</a>
        </div>
        <section class="category-projects-section">
            <h3 class="subsection-title">Projects:</h3>
            <ul class="card-list">
                <% projects.forEach(project=> { %>
                    <li class="card-item">
                        <a class="project-link" href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </li>
                    <% }); %>
            </ul>
        </section>
    </main>
    <%- include('partials/footer') %>