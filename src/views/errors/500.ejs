<%- include('../partials/header') %>
<main class="error-main server-error-main">
    <div class="error-card">
        <h1 class="page-title">Something Went Wrong</h1>
        <p class="error-message">We are experiencing technical difficulties. Our team has been notified and is working to fix the issue.</p>
        <p class="error-action">Return to the <a class="home-link" href="/">homepage</a> to continue browsing.</p>

        <% if (NODE_ENV === 'development') { %>
            <details class="error-details" open>
                <summary class="error-summary">Error Details (Development Only)</summary>
                <pre class="error-pre"><%= error %></pre>
                <pre class="error-pre"><%= stack %></pre>
            </details>
        <% } %>
    </div>
</main>
<%- include('../partials/footer') %>