<%- include('partials/header') %>
    <main class="new-project-main">
        <h1 class="page-title">Edit Service Project</h1>

        <form class="styled-form" action="/edit-project/<%= projectDetails.project_id %>" method="POST">
            <div class="form-group">
                <label for="organizationId">Sponsoring Organization:</label>
                <select id="organizationId" name="organizationId" required>
                    <% organizations.forEach((org) => { %>
                        <option
                            value="<%= org.organization_id %>"
                            <%= Number(org.organization_id) === Number(projectDetails.organization_id) ? 'selected' : '' %>
                        >
                            <%= org.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="title">Project Title:</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    maxlength="100"
                    value="<%= projectDetails.title %>"
                    required
                >
            </div>

            <div class="form-group">
                <label for="description">Description:</label>
                <textarea id="description" name="description" rows="4" maxlength="500" required><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location:</label>
                <input
                    type="text"
                    id="location"
                    name="location"
                    maxlength="100"
                    value="<%= projectDetails.location %>"
                    required
                >
            </div>

            <%
                const rawDate = projectDetails.project_date;
                const formattedDate = rawDate
                    ? new Date(rawDate).toISOString().split('T')[0]
                    : '';
            %>
            <div class="form-group">
                <label for="date">Project Date:</label>
                <input
                    type="date"
                    id="date"
                    name="date"
                    value="<%= formattedDate %>"
                    required
                >
            </div>

            <div class="form-action">
                <button class="btn-submit" type="submit">Update Project</button>
            </div>
        </form>
    </main>
<%- include('partials/footer') %>