<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>
        <%= organizationDetails.name %>
    </h2>
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> Logo" width="200">
    <p><strong>Description: </strong>
        <%= organizationDetails.description %>
    </p>
    <h3>Projects:</h3>
    <ul>
        <% projects.forEach(project => { %>
            <li><a href="project/<%= project.project_id %>">
                    <%= project.title %>
                </a></li>
            <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>