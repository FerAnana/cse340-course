<%- include('partials/header') %>
<main class="organization-detail-main">
    <h1 class="page-title"><%= title %></h1>
    
    <section class="org-profile-section">
        <div class="org-profile-header">
            <h2 class="org-heading">
                <%= organizationDetails.name %>
            </h2>
            <a class="edit-org-btn" href="/edit-organization/<%= organizationDetails.organization_id %>">Edit</a>
        </div>
        <img class="org-profile-logo" src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> Logo" width="200">
        <p class="org-description"><strong>Description: </strong>
            <%= organizationDetails.description %>
        </p>
    </section>

    <section class="org-projects-section">
        <h3 class="subsection-title">Projects:</h3>
        <ul class="card-list">
            <% projects.forEach(project => { %>
                <li class="card-item">
                    <a class="project-link" href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
            <% }); %>
        </ul>
    </section>
</main>
<%- include('partials/footer') %>