<%- include('partials/header') %>
<main class="new-project-main">
    <h1 class="page-title">Create New Service Project</h1>

    <form class="styled-form" action="/new-project" method="POST">
        <div class="form-group">
            <label for="organizationId">Sponsoring Organization:</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">Select an Organization</option>
                <% organizations.forEach((org) => { %>
                    <option value="<%= org.organization_id %>"><%= org.name %></option>
                <% }); %>
            </select>
        </div>

        <div class="form-group">
            <label for="title">Project Title:</label>
            <input type="text" id="title" name="title" minlength="3" maxlength="100" required>
        </div>

        <div class="form-group">
            <label for="description">Description:</label>
            <textarea id="description" name="description" rows="4" maxlength="500" required></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location:</label>
            <input type="text" id="location" name="location" maxlength="100" required>
        </div>

        <div class="form-group">
            <label for="date">Project Date:</label>
            <input type="date" id="date" name="date" required>
        </div>

        <div class="form-action">
            <button class="btn-submit" type="submit">Create Project</button>
        </div>
    </form>
</main>
<%- include('partials/footer') %>