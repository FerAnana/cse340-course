<%- include('partials/header') %>
    <main class="organizations-main">
        <h1 class="page-title">
            <%= title %>
        </h1>
        <p class="section-intro">Here are a few of our partner organizations:</p>
        <ul id="organizations-list" class="card-list">
            <% organizations.forEach(org=> { %>
                <li class="card-item org-card">
                    <img class="org-logo" src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">

                    <div class="org-details">
                        <a class="org-name-link" href="/organization/<%= org.organization_id %>">
                            <%= org.name %>:
                        </a>
                        <span class="org-contact">
                            <%= org.contact_email %>
                        </span>
                    </div>
                </li>
            <% }); %>
        </ul>
        <div class="page-action-footer">
            <a class="btn-action-link" href="/new-organization">Add a new organization</a>
        </div>
    </main>
    <%- include('partials/footer') %>
</html>