<%- include('partials/header') %>
<main class="new-org-main">
    <h1 class="page-title"><%= title %></h1>
    
    <form class="styled-form" action="/new-organization" method="POST">
        <div class="form-group">
            <label for="name">Organization Name</label>
            <input
                type="text"
                id="name"
                name="name"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="4"
                required
            ></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact Email</label>
            <input
                type="email"
                id="contactEmail"
                name="contactEmail"
                required
            />
        </div>

        <div class="form-action">
            <button type="submit" class="btn-submit">Create Organization</button>
        </div>
    </form>
</main>
<%- include('partials/footer') %>